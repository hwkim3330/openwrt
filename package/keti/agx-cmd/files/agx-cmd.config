# Turning this on is the difference between a dashboard and a vehicle that
# moves. It also needs can-bridge's own allow_inject, which is separate on
# purpose: two switches, both off, and neither implies the other.
config cmd 'cmd'
	option enabled '0'

	# Where TELE frames arrive, from teleop or from navigate.
	#
	# 7722, not 7602. 7602 is ouster-edge's ring, which slam2d and the tablet
	# both listen for, so agx-cmd sitting there meant two daemons wanting one
	# port and a ring arriving at something that would read it as a malformed
	# command. Nothing had noticed because agx-cmd is off by default and had
	# never run beside the mapper.
	#
	# The whole map is in doc/PORTS.md; change it there and here together.
	option listen '7722'
	option inject '127.0.0.1:7701'

	# Speed at full stick. These are walking pace, not the SCOUT MINI's
	# maximum, because the first time this drives a real machine somebody
	# will be standing next to it. Raise them deliberately.
	option max_linear '0.5'
	option max_lateral '0.5'
	option max_angular '0.8'

	# Slew limit, m/s^2 and rad/s^2. A step input is ramped to this.
	option accel '1.0'

	# Set to 1 if the vehicle strafes the wrong way. See agilex.h: the
	# lateral sign is the one convention in this path that has not been
	# checked against a real SCOUT MINI Omni.
	option lateral_invert '0'

	# 50 Hz: ugv_sdk states the motion command must be sent at >= 50 Hz.
	option rate '50'
	option deadman '300'

	# Which generation of the AgileX protocol to speak: auto, v1 or v2.
	#
	# 'auto' reads what can-bridge heard, and commands nothing until it has an
	# answer. That is deliberate: the SCOUT MINI Omni can be either generation,
	# and the two are not compatible - v1 wants a percentage of the vehicle's
	# 3.0 m/s maximum with a checksum, v2 wants mm/s without one. A v2 frame
	# for a slow crawl reads as a large yaw command to a v1 vehicle, so
	# guessing is worse than standing still.
	#
	# Set v1 or v2 only once a real vehicle has been observed, and put what was
	# observed in doc/CAN.md rather than only here.
	option protocol 'auto'
	option bridge_status '/var/run/can-bridge.json'
