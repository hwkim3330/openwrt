#!/bin/sh /etc/rc.common

START=99
STOP=05
USE_PROCD=1

PROG=/usr/sbin/agx-cmd

start_service() {
	local enabled listen inject max_linear max_lateral max_angular
	local accel lateral_invert rate deadman protocol bridge_status

	config_load agx-cmd
	config_get_bool enabled cmd enabled 0
	[ "$enabled" = "1" ] || return 0

	config_get listen      cmd listen 7722
	config_get inject      cmd inject '127.0.0.1:7701'
	config_get max_linear  cmd max_linear 0.5
	config_get max_lateral cmd max_lateral 0.5
	config_get max_angular cmd max_angular 0.8
	config_get accel       cmd accel 1.0
	config_get_bool lateral_invert cmd lateral_invert 0
	config_get rate        cmd rate 20
	config_get deadman     cmd deadman 300
	config_get protocol    cmd protocol auto
	config_get bridge_status cmd bridge_status /var/run/can-bridge.json

	# Said out loud, every start. This is the one service whose being up can
	# move something, and the log is where someone will look afterwards.
	logger -t agx-cmd \
	  "ENABLED: commanding a vehicle, limits ${max_linear}/${max_lateral} m/s ${max_angular} rad/s"
	if ! uci -q get can-bridge.bus.allow_inject | grep -q '^1$'; then
		logger -t agx-cmd \
		  "note: can-bridge allow_inject is off, so nothing reaches the bus yet"
	fi
	# Worth saying at start rather than leaving someone to wonder why an armed
	# stick moves nothing: with protocol=auto and no answer yet, this daemon
	# withholds every command on purpose.
	if [ "$protocol" = "auto" ] && \
	   ! grep -q '"agilex_protocol": "v[12]"' "$bridge_status" 2>/dev/null; then
		logger -t agx-cmd \
		  "note: protocol=auto and $bridge_status does not say v1 or v2 yet, so no commands will be sent until it does"
	fi

	procd_open_instance
	procd_set_param command "$PROG" \
		--listen "$listen" \
		--inject "$inject" \
		--max-linear "$max_linear" \
		--max-lateral "$max_lateral" \
		--max-angular "$max_angular" \
		--accel "$accel" \
		--rate "$rate" \
		--deadman "$deadman" \
		--protocol "$protocol" \
		--bridge-status "$bridge_status" \
		--status /var/run/agx-cmd.json
	[ "$lateral_invert" = "1" ] && procd_append_param command --lateral-invert
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f /var/run/agx-cmd.json
}

service_triggers() {
	procd_add_reload_trigger "agx-cmd"
}
