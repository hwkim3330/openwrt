config can 'bus'
	option enabled '0'

	option interface 'can0'

	# CAN 2.0B at 500 kbps is what an AgileX SCOUT MINI uses.
	option bitrate '500000'

	# Where to forward received frames. Empty means no forwarding; the
	# status file is still written for the dashboard.
	option remote ''

	# Accept frames from the network on this port. Forwarding them onto the
	# bus additionally requires allow_inject below.
	option listen '7701'

	# Putting frames on a vehicle bus from here means a motion command with
	# a WiFi hop in the path, and a stalled link leaves the last command
	# being acted on. Keep this off unless you are on the bench and know
	# exactly why you want it. See doc/CAN.md.
	option allow_inject '0'

	# Hex CAN ids to decode into the status file. Leave empty and turn on
	# discover to find out what your vehicle actually sends - do not trust
	# ids copied from a forum, they differ between firmware versions.
	option track ''
	option discover '0'

	option status_interval '200'
