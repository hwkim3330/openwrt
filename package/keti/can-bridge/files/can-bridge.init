#!/bin/sh /etc/rc.common

START=97
STOP=10
USE_PROCD=1

PROG=/usr/sbin/can-bridge

start_service() {
	local enabled interface bitrate remote listen allow_inject track
	local discover status_interval

	config_load can-bridge
	config_get_bool enabled bus enabled 0
	[ "$enabled" = "1" ] || return 0

	config_get interface bus interface can0
	config_get bitrate   bus bitrate 500000
	config_get remote    bus remote
	config_get listen    bus listen 7701
	config_get_bool allow_inject bus allow_inject 0
	config_get track     bus track
	config_get_bool discover bus discover 0
	config_get status_interval bus status_interval 200

	# The interface has to exist and be up before the bridge can bind it.
	if ! /usr/sbin/can-up "$interface" "$bitrate" >/dev/null 2>&1; then
		logger -t can-bridge "cannot bring up $interface; not starting"
		return 1
	fi

	procd_open_instance
	procd_set_param command "$PROG" \
		--interface "$interface" \
		--status /var/run/can-bridge.json \
		--status-interval "$status_interval"

	[ -n "$remote" ] && procd_append_param command --remote "$remote"
	[ -n "$listen" ] && procd_append_param command --listen "$listen"
	[ -n "$track" ]  && procd_append_param command --track "$track"
	[ "$discover" = "1" ] && procd_append_param command --discover
	if [ "$allow_inject" = "1" ]; then
		procd_append_param command --allow-inject
		logger -t can-bridge "WARNING: network-to-bus injection is ENABLED"
	fi

	# Paced rather than unlimited-and-instant: a device that is not
	# plugged in yet must not become a hot restart loop.
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f /var/run/can-bridge.json
}

service_triggers() {
	procd_add_reload_trigger "can-bridge"
}
